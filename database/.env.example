# =============================================================================
# database/.env.example — credenciais operacionais do pipeline de dados da OPP
# =============================================================================
# Modelo. Copie para `database/.env`, preencha o que precisar e NUNCA commite o
# `.env` (já está no .gitignore). O `.env` é a camada operacional: o segredo não
# aparece na linha de comando, no histórico do shell nem no crontab.
#
# COMO USAR — os geradores *_lake.py CARREGAM este arquivo sozinhos (load_dotenv no
# início do main()). Basta rodar, em QUALQUER terminal novo ou no cron:
#
#     python3 database/scripts/gerar_seed_tempo_abertura_lake.py --write-mongo
#
# Não precisa mais `source`. (Se quiser exportar manualmente mesmo assim:
# `set -a; source database/.env; set +a` — o que estiver exportado vence o .env.)
#
# PRECEDÊNCIA: flag de linha de comando > variável exportada no shell > .env >
# default interno do script. Chave em branco aqui = usa o default do script.
#
# O QUE PRECISA PREENCHER:
#   - SEMPRE para --write-mongo: OPP_MONGO_USER / OPP_MONGO_PASS (bloco no fim).
#   - Os blocos do LAKE são OPCIONAIS: host (10.19.4.174:27018), authSource (admin)
#     e usuário (padrão usr_<BASE>:usr_<BASE>) já são default no script. Só preencha
#     para SOBRESCREVER (outro host, túnel SSH, credencial diferente).
# =============================================================================

# --- OPP: banco de destino DadosOPP (--write-mongo) — *** OBRIGATÓRIO *** -----------
# Usado por todos os geradores com --write-mongo (escritor comum). O usuário do OPP
# NÃO segue o padrão usr_<BASE> (é usrdadosopp), por isso precisa vir daqui.
# Defaults do script: host=127.0.0.1, port=27017, db=DadosOPP, authSource=OPP_MONGO_DB.
OPP_MONGO_USER=
OPP_MONGO_PASS=
OPP_MONGO_HOST=
OPP_MONGO_PORT=
OPP_MONGO_DB=
OPP_AUTH_DB=

# =============================================================================
# LAKE do Sebrae (10.19.4.174:27018) — blocos OPCIONAIS (override).
# Defaults no script: host=10.19.4.174, port=27018, authSource=admin,
# user=pass=usr_<BASE> (usr_REDESIM, usr_RAIS, usr_RECEITA_FEDERAL, usr_PNCP).
# Deixe em branco para usar os defaults; preencha só o que for diferente.
# =============================================================================

# --- Lake: base REDESIM (BRASIL_<ano> — solicitações de abertura) -------------------
# Usado por gerar_seed_tempo_abertura_lake.py e inspecionar_redesim_lake.py.
REDESIM_MONGO_HOST=
REDESIM_MONGO_PORT=
REDESIM_MONGO_DB=
REDESIM_MONGO_USER=
REDESIM_MONGO_PASS=
REDESIM_AUTH_DB=
# Túnel SSH (opcional — só se o lake não estiver acessível direto):
REDESIM_SSH_HOST=
REDESIM_SSH_PORT=
REDESIM_SSH_USER=
REDESIM_SSH_KEY=
REDESIM_SSH_PASSWORD=

# --- Lake: base RAIS (vínculos) -----------------------------------------------------
# Usado por gerar_seed_escolaridade.py e gerar_seed_remuneracao_media_lake.py (e demais
# geradores RAIS). Overrides de schema (só se o dump renomeou os campos; rode --inspect):
# RAIS_CAMPO_MUNICIPIO / RAIS_CAMPO_ESCOLARIDADE / RAIS_CAMPO_VINCULO_ATIVO / RAIS_CAMPO_REMUN.
# Remuneração como string com vírgula ("1.234,56")? RAIS_REMUN_DECIMAL_COMMA=1.
RAIS_MONGO_HOST=
RAIS_MONGO_PORT=
RAIS_MONGO_DB=
RAIS_MONGO_USER=
RAIS_MONGO_PASS=
RAIS_AUTH_DB=
# Túnel SSH (opcional — só se a RAIS não estiver acessível direto):
RAIS_SSH_HOST=
RAIS_SSH_PORT=
RAIS_SSH_USER=
RAIS_SSH_KEY=
RAIS_SSH_PASSWORD=

# --- Lake: base RECEITA_FEDERAL (RF_ESTABELECIMENTOS / RF_EMPRESAS / RF_SIMPLES) ----
# Usado por gerar_seed_negocios_rfb_lake.py e gerar_seed_mpe_compras_publicas_lake.py.
RFB_MONGO_HOST=
RFB_MONGO_PORT=
RFB_MONGO_DB=
RFB_MONGO_USER=
RFB_MONGO_PASS=
RFB_AUTH_DB=

# --- Lake: base PNCP (CONTRATOS_<ano>) ---------------------------------------------
# Usado por gerar_seed_mpe_compras_publicas_lake.py.
PNCP_MONGO_HOST=
PNCP_MONGO_PORT=
PNCP_MONGO_USER=
PNCP_MONGO_PASS=
PNCP_AUTH_DB=

# --- Lake: base ESTBAN (AAAAMM — Estatística Bancária por Município, BCB) -----------
# Usado por gerar_seed_credito_financiamento_lake.py. Defaults: host/porta/authSource do
# lake + user=pass=usr_ESTBAN. Os ESTBAN_CAMPO_*/VERBETE_* abaixo só p/ sobrescrever o
# schema (rode --inspect uma vez p/ confirmar nomes de campo e o prefixo dos verbetes).
ESTBAN_MONGO_HOST=
ESTBAN_MONGO_PORT=
ESTBAN_MONGO_DB=
ESTBAN_MONGO_USER=
ESTBAN_MONGO_PASS=
ESTBAN_AUTH_DB=
# Schema (override só se o dump renomeou): campos e cesta de verbetes de crédito.
ESTBAN_CAMPO_UF=
ESTBAN_CAMPO_CODMUN=
ESTBAN_CAMPO_CNPJ=
ESTBAN_VERBETE_PREFIX=
ESTBAN_CREDITO_CODES=

# --- Lake: base IDEB (INEP — Índice de Desenvolvimento da Educação Básica) ----------
# Usado por gerar_seed_ideb_lake.py. Defaults: host/porta/authSource do lake +
# user=pass=usr_IDEB. IDEB_MONGO_DB default = "IDEB"; se o lake expuser a base como
# "usr_IDEB", defina IDEB_MONGO_DB=usr_IDEB. IDEB_COLLECTION só se houver mais de uma
# coleção. IDEB_REDE default = "PUBLICA"; IDEB_CAMPO_*/IDEB_OBSERVADO_PREFIX só p/
# sobrescrever o schema (rode --inspect uma vez p/ confirmar REDE/SERIE e os campos).
IDEB_MONGO_HOST=
IDEB_MONGO_PORT=
IDEB_MONGO_DB=
IDEB_MONGO_USER=
IDEB_MONGO_PASS=
IDEB_AUTH_DB=
IDEB_COLLECTION=
IDEB_REDE=
# Schema (override só se o dump renomeou):
IDEB_CAMPO_UF=
IDEB_CAMPO_CODMUN=
IDEB_CAMPO_MUNICIPIO=
IDEB_CAMPO_REDE=
IDEB_CAMPO_SERIE=
IDEB_OBSERVADO_PREFIX=

# --- Lake: base IBGE (dump de tabelas SIDRA: PIB 5938, população, censo…) ------------
# Usada por inspecionar_ibge_lake.py (inventário) e, no futuro, pelos geradores
# gerar_seed_pib_lake.py etc. A base REAL no lake chama-se "IBGE" (confirmado jun/2026);
# o usuário é usr_IBGE (tem `find`; NÃO tem listCollections na base `usr_IBGE`, mas TEM
# na `IBGE`). Uma coleção por tabela SIDRA (nome = nº da tabela). Defaults: host/porta/
# authSource do lake + credencial usr_IBGE. Tudo em branco = usa os defaults.
IBGE_MONGO_HOST=
IBGE_MONGO_PORT=
IBGE_MONGO_DB=
IBGE_MONGO_USER=
IBGE_MONGO_PASS=
IBGE_AUTH_DB=
IBGE_COLLECTION=

# --- Lake: base BCB (Banco Central — séries/ESTBAN/PIX/crédito por município) --------
# Usada por inspecionar_bcb_lake.py (explorador schema-agnóstico). Defaults: host/porta/
# authSource do lake + credencial usr_BCB. BCB_MONGO_DB default = "BCB"; se o lake expuser
# a base com outro nome, defina aqui. Tudo em branco = usa os defaults do script.
BCB_MONGO_HOST=
BCB_MONGO_PORT=
BCB_MONGO_DB=
BCB_MONGO_USER=
BCB_MONGO_PASS=
BCB_AUTH_DB=
