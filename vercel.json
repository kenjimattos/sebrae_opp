{
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/municipalities", "destination": "/api-snapshot/municipalities.json" },
    { "source": "/api/municipalities/:id", "destination": "/api-snapshot/municipalities/:id.json" },
    { "source": "/api/emendas", "destination": "/api-snapshot/emendas.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
