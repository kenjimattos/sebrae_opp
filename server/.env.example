# Conexão com o MongoDB DadosOPP (banco em 10.1.141.23).
# Copie para .env e preencha usuário/senha. .env NÃO é versionado.
MONGO_URI=mongodb://USUARIO:SENHA@10.1.141.23:27017/?authSource=DadosOPP
MONGO_DB=DadosOPP

# Porta do processo da API na máquina da app (10.1.100.99). O Nginx faz proxy
# de /api/* para cá.
PORT=3000
HOST=0.0.0.0

# --- IA (POST /api/ai) --------------------------------------------------------
# OPCIONAIS. Sem OPENROUTER_API_KEY a API sobe normalmente e só o /api/ai
# responde `missing_key` — o frontend mostra "O serviço de IA não está
# configurado neste ambiente" e as demais rotas seguem intactas.
#
# A chave é do OpenRouter e fica SÓ no servidor (nunca com prefixo VITE_, que
# vazaria no bundle). Exige saída de rede da máquina da app para
# https://openrouter.ai — se a rede do Sebrae bloquear, as chamadas expiram no
# timeout de 30s do cliente. Teste antes com:
#   curl -sS -m 10 -o /dev/null -w '%{http_code}\n' https://openrouter.ai/api/v1/models
#
# OPENROUTER_MODEL é opcional (default em api/_lib/openrouter.ts). O catálogo
# `:free` rotaciona — confira em https://openrouter.ai/api/v1/models antes de trocar.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
