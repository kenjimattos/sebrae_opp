# Conexão com o MongoDB DadosOPP (banco em 10.1.141.23).
# Copie para .env e preencha usuário/senha. .env NÃO é versionado.
MONGO_URI=mongodb://USUARIO:SENHA@10.1.141.23:27017/?authSource=DadosOPP
MONGO_DB=DadosOPP

# Porta do processo da API na máquina da app (10.1.100.99). O Nginx faz proxy
# de /api/* para cá.
PORT=3000
HOST=0.0.0.0

# Validade do cache de resposta em memória (ms, default 300000 = 5 min). Vale
# para /api/map, /api/emendas, /api/estado, /api/municipalities e /api/municipalities/:id, e é
# também o `max-age` mandado ao navegador. É quanto tempo uma carga nova do ETL
# pode demorar a aparecer na tela — reiniciar o serviço zera na hora.
# PAYLOAD_CACHE_TTL_MS=300000

# --- IA (POST /api/ai) --------------------------------------------------------
# OPCIONAL. Sem GOOGLE_SERVICE_ACCOUNT_JSON válida a API sobe normalmente e só o
# /api/ai responde 503 `unavailable` — o frontend mostra "O assistente está
# indisponível no momento", o motivo vai para o log e as demais rotas seguem
# intactas.
#
# É o .json inteiro da service account (formato padrão do GCP, project_id no
# topo), numa linha só entre aspas simples. Traz a CHAVE PRIVADA: só neste
# arquivo, nunca em log nem no repositório. Exige saída de rede da máquina da
# app para o OAuth e o Vertex do Google — se a rede do Sebrae bloquear, as
# chamadas expiram no timeout de 30s do cliente. Teste antes com:
#   curl -sS -m 10 -o /dev/null -w '%{http_code}\n' https://oauth2.googleapis.com/token
#   curl -sS -m 10 -o /dev/null -w '%{http_code}\n' https://aiplatform.googleapis.com/
# (qualquer código HTTP serve; 000 é que a rede não passa).
#
# VERTEX_MODEL e VERTEX_LOCATION são opcionais (defaults em api/_lib/vertex.ts).
# O que existe é por projeto: no do Sebrae só gemini-3.8-flash em `global` responde.
GOOGLE_SERVICE_ACCOUNT_JSON=
VERTEX_MODEL=
VERTEX_LOCATION=
#
# Travas de volume do /api/ai (ver "Travas de volume" no server/README.md).
# Opcionais; os defaults são valores iniciais, a ajustar pelo log de uso.
# Rajada por IP por minuto, cota diária por IP e teto global diário.
# AI_RATE_PER_MIN=10
# AI_RATE_PER_DAY=150
# AI_DAILY_CAP=3000
